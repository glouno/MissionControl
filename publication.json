{
  "schemaVersion": 1,
  "source": [
    "src/**/*.ts",
    "scripts/*.mjs",
    "scripts/*.py",
    "docs/*.md",
    "docs/*.json",
    "examples/*.json",
    "profiles/*.json",
    "environments/worker/*",
    "connectors/matrix/Cargo.toml",
    "connectors/matrix/Cargo.lock",
    "connectors/matrix/src/**/*.rs",
    ".github/workflows/*.yml",
    ".gitignore",
    ".npmrc",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "publication.json",
    "THIRD_PARTY_NOTICES.md",
    "scripts/missioncontrol",
    "scripts/install-status.sh"
  ],
  "installed": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/*.md",
    "docs/*.json",
    "examples/*.json",
    "profiles/*.json",
    "environments/worker/*",
    "publication.json",
    "package.json",
    "package-lock.json",
    "assets/source.tar.gz",
    "assets/source-manifest.json",
    "THIRD_PARTY_NOTICES.md",
    "scripts/missioncontrol",
    "scripts/install-status.sh"
  ],
  "excludedDirectories": [
    ".git",
    "node_modules",
    "dist",
    "target",
    "coverage",
    "assets"
  ],
  "prohibitedSegments": [
    "missions",
    "reports",
    "secrets",
    "state",
    "backups",
    "logs",
    ".azure",
    ".aws",
    ".codex",
    ".claude",
    ".ssh"
  ],
  "prohibitedExtensions": [
    ".db",
    ".sqlite",
    ".sqlite3",
    ".bundle",
    ".pem",
    ".key",
    ".pfx",
    ".log",
    ".tgz",
    ".zip"
  ]
}
